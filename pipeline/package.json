{
  "name": "ae-agent-pipeline",
  "version": "0.1.0",
  "description": "Index After Effects projects into searchable recipes/cards for a CEP agent",
  "type": "commonjs",
  "main": "src/index.js",
  "bin": {
    "ae-agent": "bin/ae-agent.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "index": "node bin/ae-agent.js index",
    "search": "node bin/ae-agent.js search",
    "extract": "node bin/ae-agent.js extract",
    "batch-export": "node bin/ae-agent.js batch-export"
  },
  "optionalDependencies": {
    "after-effects": "^0.4.3"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
